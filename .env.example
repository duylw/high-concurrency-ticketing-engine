# ==============================================================================
# 1. Server Runtime & Networking
# ==============================================================================
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5001

# ==============================================================================
# 2. PostgreSQL Database Connection (Prisma ORM)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?schema=public"

# ==============================================================================
# 3. Redis Cache & BullMQ Queue Connection
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password is required (e.g. local dev)
REDIS_PASSWORD=

# ==============================================================================
# 4. Authentication & JWT Cryptographic Secrets (Min 32 characters)
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# 5. Business Logic & Concurrency Control
# ==============================================================================
# Ticket Hold Duration in milliseconds (default: 600000 = 10 minutes)
TICKET_HOLD_DURATION_MS=600000
# Maximum tickets a customer can hold/purchase per order (default: 4)
MAX_TICKETS_PER_ORDER=4

# ==============================================================================
# 6. Cache TTL Policies (in Seconds)
# ==============================================================================
# Event detail cache TTL (default: 3600 = 1 hour)
EVENT_CACHE_TTL_SECONDS=3600
# Event catalog list cache TTL (default: 300 = 5 minutes)
EVENT_LIST_CACHE_TTL_SECONDS=300

# ==============================================================================
# 7. Rate Limiting (Security & Anti-Abuse)
# ==============================================================================
# Authentication endpoint rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Maximum login/register requests per IP in the window (default: 1000 in dev, 20 in prod)
RATE_LIMIT_AUTH_MAX=20
