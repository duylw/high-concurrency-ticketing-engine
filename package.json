    "start:worker": "node dist/worker.js",
    "db:seed": "tsx src/scripts/seed-demo-users.js",
    "seed:events": "tsx src/scripts/seed-demo-events.js",
    "cache:clear": "tsx src/scripts/clear-cache.js",
    "db:reset": "tsx src/scripts/reset-and-seed.js",
    "test:infra": "tsx src/scripts/test-infra.js",
    "test:auth": "tsx src/scripts/test-auth-advanced.js",
    "test:cache": "tsx src/scripts/test-cache.js",
    "test:concurrency": "tsx src/scripts/test-concurrency.js",
    "test:queue": "tsx src/scripts/test-queue.js",
    "test:checkout": "tsx src/scripts/test-checkout.js",
    "test:domain": "tsx src/scripts/test-domain-expansion.js",
    "test:ui": "tsx src/scripts/test-frontend-ui.js",
    "test:frontend-auth": "tsx src/scripts/test-frontend-auth.js",
    "test:customer": "tsx src/scripts/test-frontend-customer.js",
    "test:organizer-studio": "tsx src/scripts/test-frontend-organizer-studio.js",
    "test:gate-scanner": "tsx src/scripts/test-frontend-gate-scanner.js",
    "test:itemized-tickets": "tsx src/scripts/test-itemized-tickets.js",
    "test:frontend-multi-tickets": "tsx src/scripts/test-frontend-multi-tickets.js",
    "test:real-qr": "tsx src/scripts/test-real-qr-scanner.js",
    "test:ui-cleanup": "tsx src/scripts/test-production-ui-cleanup.js",
    "test:postman": "npx --yes newman run docs/postman_collection.json",
    "test:prod-health": "tsx src/scripts/test-prod-health.js",
    "test:client-scaffold": "node src/scripts/test-frontend-scaffold.js",
    "test:client-auth": "node src/scripts/test-frontend-auth-flow.js",
    "test:tailwind-migration": "node src/scripts/test-tailwind-migration.js",
    "test:customer-flow": "node src/scripts/test-frontend-customer-flow.js",
    "benchmark:read": "tsx src/scripts/benchmark-read.js",
    "benchmark:flash-sale": "tsx src/scripts/benchmark-flash-sale.js",
    "test:benchmark": "npm run benchmark:read && npm run benchmark:flash-sale",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
